<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms><UseWPF>true</UseWPF><PlatformTarget>x64</PlatformTarget>
    <AutoCADDir Condition="'$(AutoCADDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2025</AutoCADDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/CadMcp.AutoCAD/NativeTables.cs;../../src/CadMcp.AutoCAD/SpdsDrafting.cs" />
    <Compile Include="../../src/CadMcp.AutoCAD/ReadingMetadata.cs;../../src/CadMcp.AutoCAD/PreviewRendering.cs;../../src/CadMcp.AutoCAD/WorkSafety.cs;../../src/CadMcp.AutoCAD/TableLinks.cs;../../src/CadMcp.AutoCAD/DrawingQuality.cs;../../src/CadMcp.AutoCAD/SolidModeling.cs;../../src/CadMcp.AutoCAD/StructuralAssemblies.cs;../../src/CadMcp.AutoCAD/StructuralSolids.cs;../../src/CadMcp.AutoCAD/VerticalEditing.cs" />
    <Compile Include="../../src/CadMcp.AutoCAD/DrawingReview.cs" />
    <Compile Include="../../src/CadMcp.AutoCAD/QualityChecks.cs" Link="QualityChecks.cs" />
    <Using Include="System.IO" />
    <!-- Compile production executors into an isolated test assembly so an installed preview can coexist. -->
    <Compile Include="../../src/CadMcp.Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <Compile Include="../../src/CadMcp.AutoCAD/Documents.cs" Link="Documents.cs" />
    <Compile Include="../../src/CadMcp.AutoCAD/Dispatcher.cs" Link="Dispatcher.cs" />
    <Compile Include="../../src/CadMcp.AutoCAD/Edits.cs" Link="Edits.cs" />
    <Compile Include="../../src/CadMcp.AutoCAD/Sheets.cs" Link="Sheets.cs" />
    <Compile Include="../../src/CadMcp.AutoCAD/RasterImages.cs" Link="RasterImages.cs" />
    <Compile Include="../../src/CadMcp.AutoCAD/Exports.cs" Link="Exports.cs" />
    <Compile Include="../../src/CadMcp.AutoCAD/PdfRepair.cs" Link="PdfRepair.cs" />
    <Compile Include="../../src/CadMcp.AutoCAD/Reader.cs" Link="Reader.cs" />
    <Compile Include="../../src/CadMcp.AutoCAD/Catalog.cs" Link="Catalog.cs" />
    <Compile Include="../../src/CadMcp.AutoCAD/Verticals.cs" Link="Verticals.cs" />
    <Compile Include="../../src/CadMcp.AutoCAD/DrawingSearch.cs" Link="DrawingSearch.cs" />
    <Compile Include="../../src/CadMcp.AutoCAD/UndoGroup.cs" Link="UndoGroup.cs" />
    <Reference Include="AcMgd"><HintPath>$(AutoCADDir)\AcMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcCoreMgd"><HintPath>$(AutoCADDir)\AcCoreMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgd"><HintPath>$(AutoCADDir)\acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AcDbMgdBrep"><HintPath>$(AutoCADDir)/AcDbMgdBrep.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
